---
import SwatchCopy from "patmos-design-system/site/SwatchCopy.astro";
import { byName, t } from "../lib/theme.js";

const { colors, fill = false } = Astro.props;
const specs = ["HEX", "RGB", "CMYK", "PMS"];
---

<div class:list={["color-specs", { "color-specs--fill": fill }]}>
  {
    colors.map((color) => {
      const token = byName.get(color.token);
      return (
        <article class="color-spec">
          <button
            class={`color-spec__swatch ${t("label-s")}`}
            type="button"
            style={`background: var(${token.cssVariable})`}
            data-copy={`#${color.hex}`}
            aria-label={`Copy ${color.name} #${color.hex}`}
            title="Copy hex"
          >
            <SwatchCopy hex={`#${color.hex}`} />
          </button>
          <h3 class={t("body-m-medium")}>{color.name}</h3>
          <dl class="spec-table">
            {specs.filter((spec) => color[spec.toLowerCase()]).map((spec) => (
              <div class="spec-table__row">
                <dt class={`muted ${t("label-s")}`}>{spec}</dt>
                <dd class={t("label-s")}>{color[spec.toLowerCase()]}</dd>
              </div>
            ))}
          </dl>
        </article>
      );
    })
  }
</div>
